# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# local sqlite cache/index do vault (reconstruível, nunca fonte de verdade) —
# hoje vive em ~/.study-app/index/ (fora do repo), .data/ é só resquício de
# uma localização antiga. *.sqlite/*.db abaixo cobre qualquer índice que
# venha a aparecer aqui por engano, não importa o caminho.
/.data/
*.sqlite
*.sqlite3
*.db

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# tauri (empacotamento desktop) — /target e /gen também já são ignorados
# dentro do próprio src-tauri/.gitignore; repetido aqui de propósito pra ficar
# explícito num único lugar (é onde o AppImage final também fica, dentro de
# target/release/bundle/appimage/ — *.AppImage abaixo cobre isso de novo,
# redundante de propósito, caso o build seja gerado em outro lugar).
# O binário Node copiado (binaries/) é grande demais e específico da máquina,
# nunca deve ser versionado.
/src-tauri/target/
/src-tauri/gen/
*.AppImage
/src-tauri/binaries/*
!/src-tauri/binaries/.gitkeep

# Notas pessoais de planejamento/contexto do projeto — ficam na pasta local
# pra referência, mas nunca são versionadas.
/CLAUDE.md
/contexto-e-proximas-tarefas.md
/contexto-e-proximas-tarefas-v2.md
/contexto-e-proximas-tarefas-v3.md
/requisitos-app-estudo.md
/resumo-tecnico-projeto.md
