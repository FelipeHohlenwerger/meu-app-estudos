{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "enables the default permissions",
  "windows": [
    "main"
  ],
  "remote": {
    "urls": ["http://127.0.0.1:47821/*"]
  },
  "permissions": [
    "core:default",
    "shell:allow-spawn",
    "shell:allow-kill",
    {
      "identifier": "shell:allow-execute",
      "allow": [{ "name": "binaries/next-server", "sidecar": true, "args": true }]
    },
    "dialog:allow-open",
    "allow-pick-folder"
  ]
}
