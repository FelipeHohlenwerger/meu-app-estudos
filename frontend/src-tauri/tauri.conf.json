{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Study App",
  "version": "0.1.8",
  "identifier": "com.felipehohlenwerger.studyapp",
  "build": {
    "frontendDist": "../dist-placeholder",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Study App",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/next-server"],
    "resources": {
      "../.next/standalone": "standalone"
    },
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}
