# Gere sua chave em https://aistudio.google.com/apikey (tier gratuito)
GEMINI_API_KEY=

# Opcional — modelo do Gemini a usar (padrão no código: gemini-flash-latest,
# um alias que a Google mantém sempre apontado pro modelo flash atual)
# GEMINI_MODEL=gemini-flash-latest

# URL do MTranServer (github.com/xxnuo/mtranserver) — servidor de tradução
# offline rodando via Docker num computador da rede local (hoje: o notebook;
# ver CLAUDE.md pro plano de migração pro servidor Ubuntu quando tiver RAM).
# Ex: http://192.168.0.42:8989 — sem barra no final.
MTRANSERVER_URL=

# Opcional — só necessário se o container foi iniciado com MT_API_TOKEN
MTRANSERVER_API_TOKEN=
